# Salin ke .env lalu ganti SEMUA nilai CHANGE_ME. Jangan commit .env.

# --- Versi image (dipin; verifikasi tag dengan `docker compose pull` sebelum dipakai) ---
POSTGRES_IMAGE=pgvector/pgvector:0.8.0-pg16
REDIS_IMAGE=redis:7.4-alpine
OLLAMA_IMAGE=ollama/ollama:0.6.5

# --- Postgres ---
POSTGRES_DB=medvoice
POSTGRES_USER=medvoice
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_HOST_PORT=5432   # ganti bila bentrok (mis. 5433)

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis

# --- API ---
DATABASE_URL=postgresql+psycopg://medvoice:CHANGE_ME_postgres@postgres:5432/medvoice
REDIS_URL=redis://:CHANGE_ME_redis@redis:6379/0
JWT_SECRET=CHANGE_ME_jwt
API_KEY_PEPPER=CHANGE_ME_pepper

# --- Batas ---
LOGIN_RATE_PER_MIN=10
WORKER_CONCURRENCY=2
STT_BUILD_GPU=0
AUDIO_DIR=/audio
MAX_AUDIO_MB=200
JWT_TTL_MINUTES=480

# --- LLM (diganti lewat env, dipanggil via call_llm() di Fase 1) ---
LLM_BACKEND=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Embedding & pemetaan kode ---
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_CPU=true      # true = CPU (tidak menggusur LLM dari VRAM); false = GPU (lebih cepat, mis. saat memuat tabel)
MAP_CANDIDATES_K=8
MAP_TRANSLATE=true
MAP_MARGIN=0.05

# --- STT ---
STT_URL=http://stt:9000
STT_MODEL=large-v3-turbo
STT_LIVE_MODEL=base
STT_REFINE_MODEL=small
STT_PARTIAL_MODEL=base
# Transkrip langsung (WebSocket): model teks akhir tiap ucapan (kosong = STT_REFINE_MODEL). Di GPU: large-v3-turbo jauh lebih akurat.
STT_STREAM_FINAL_MODEL=
# Teks sementara streaming (kosong = STT_PARTIAL_MODEL=base). JANGAN samakan dengan model final di CPU: terukur lebih lambat (final tertinggal >10 dtk) tanpa WER lebih baik.
STT_STREAM_PARTIAL_MODEL=
STT_STREAM_FINAL_BEAM=1
STT_LANGUAGE=id
STT_COMPUTE_TYPE=int8
STT_DEVICE=cpu

# --- Embedding (dipakai Fase 2) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Kebijakan data ---
TRANSCRIPT_RETENTION_DAYS=30
