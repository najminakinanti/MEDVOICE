   "text": "Ada demam, Bu?"
  },
  {
   "speaker": "pasien",
   "start_ms": 2000,
   "end_ms": 4280,
   "text": "Tidak demam, Dok. Cuma batuk dua hari."
  },
  {
   "speaker": "dokter",
   "start_ms": 4280,
   "end_ms": 6280,
   "text": "Nyeri dada atau sesak napas?"
  },
  {
   "speaker": "pasien",
   "start_ms": 6280,
   "end_ms": 8620,
   "text": "Tidak ada nyeri dada, tidak sesak juga."
  },
  {
   "speaker": "dokter",
   "start_ms": 8620,
   "end_ms": 10620,
   "text": "Ada alergi obat?"
  },
  {
   "speaker": "pasien",
   "start_ms": 10620,
   "end_ms": 12620,
   "text": "Tidak ada alergi."
  },
  {
   "speaker": "dokter",
   "start_ms": 12620,
   "end_ms": 17000,
   "text": "Baik, ini batuk pilek biasa. Saya beri cetirizine 10 mg satu kali sehari."
